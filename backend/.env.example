PORT=5000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/mediwave?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Optional: comma-separated frontend origins for production CORS.
# Example: https://mediwave-project.vercel.app,http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Optional email settings.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=example@example.com
EMAIL_PASS=your-email-password
